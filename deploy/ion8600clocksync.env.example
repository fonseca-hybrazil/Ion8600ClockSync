# Copie este arquivo para /etc/ion8600clocksync/ion8600clocksync.env no servidor
# e preencha os valores reais. NUNCA commitar o arquivo real (.env) — apenas este
# .example, sem usuário/senha reais do banco.

ConnectionStrings__Ion8600SyncConnection=Server=SUBSTITUA_PELO_IP_DO_SQL_SERVER;Database=ION8600Sync;User Id=SUBSTITUA;Password=SUBSTITUA_AQUI;TrustServerCertificate=True

AppSettings__CheckIntervalSeconds=30
AppSettings__SyncIntervalMinutes=360
AppSettings__MasterAddress=1
AppSettings__DnpTimeoutSeconds=10
